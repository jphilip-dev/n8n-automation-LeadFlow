        "message": "={{\n  '<div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333;\">' +\n  $('Basic LLM Chain').item.json.output.response\n    .replace(/\\\\n/g, '\\n')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .split(/\\n\\s*\\n/)\n    .map(p => p.trim())\n    .filter(Boolean)\n    .map(p => '<p style=\"margin: 0 0 16px;\">' + p.replace(/\\n/g, '<br>') + '</p>')\n    .join('') +\n  '</div>'\n}}\n",
